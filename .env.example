# Copy to .env for development. Never commit real credentials.
DATABASE_URL=postgresql://lifeplanning:local-development-only@127.0.0.1:5437/lifeplanning?schema=life_planning
APP_URL=http://127.0.0.1:3017
SESSION_SECRET=replace-with-at-least-48-random-characters
OWNER_EMAIL=owner@example.com
OWNER_NAME=Your name
OWNER_PASSWORD=replace-with-a-long-unique-temporary-password
# Use a dedicated disposable database and account for tests.
TEST_DATABASE_URL=postgresql://lifeplanning:local-development-only@127.0.0.1:5437/lifeplanning_test?schema=life_planning
TEST_OWNER_EMAIL=qa-lifeplanning@example.test
TEST_OWNER_PASSWORD=replace-with-a-distinct-test-password
