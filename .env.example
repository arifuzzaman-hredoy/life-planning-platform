# Copy to .env for development. Never commit real credentials.
DATABASE_URL=postgresql://lifeplanning:local-development-only@127.0.0.1:5437/lifeplanning?schema=life_planning
# Optional direct migration URL; Neon pooled hosts are automatically made direct for CLI operations.
# DIRECT_DATABASE_URL=postgresql://lifeplanning:local-development-only@127.0.0.1:5437/lifeplanning?schema=life_planning
APP_URL=http://127.0.0.1:3017
SESSION_SECRET=replace-with-at-least-48-random-characters
# Optional dedicated encryption key; otherwise SESSION_SECRET encrypts saved DeepSeek keys.
# Keep the encryption key stable when restoring a database backup.
# AI_ENCRYPTION_KEY=replace-with-at-least-48-random-characters
# Server-only scheduler token (32+ characters); set before enabling scheduled routines.
# APP_CRON_SECRET=replace-with-at-least-48-random-characters
OWNER_EMAIL=owner@example.com
OWNER_NAME=Your name
OWNER_PASSWORD=replace-with-a-long-unique-temporary-password
# Tests use DATABASE_URL above. In a separate private CI environment file,
# point DATABASE_URL to the dedicated test database, then explicitly opt in.
# RUN_DB_TESTS=true
# RUN_E2E_TESTS=true
# E2E_BASE_URL=http://127.0.0.1:3017
# Tests generate disposable accounts and remove only their own fixtures.
