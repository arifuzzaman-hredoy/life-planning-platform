# Staging only. Never reuse production secrets or the production database.
DATABASE_URL=postgresql://staging-user:replace-with-private-password@staging-db.example.invalid/life_planning_staging?sslmode=require
APP_URL=https://staging.myplan.oxytumzone.com
SESSION_SECRET=replace-with-staging-random-secret-at-least-48-characters
AI_ENCRYPTION_KEY=replace-with-staging-random-encryption-key-at-least-48-characters
APP_CRON_SECRET=replace-with-staging-random-cron-secret-at-least-48-characters
METRICS_TOKEN=replace-with-staging-random-metrics-token-at-least-48-characters
TRUST_PROXY=true
